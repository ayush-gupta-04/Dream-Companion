# Clerk Authentication Publishable Key (Required)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key

# Backend API Base URL (e.g. https://your-backend.onrender.com)
# Leave empty for local development to use Vite's local dev proxy.
VITE_API_URL=

# Backend Socket.IO URL (Optional: defaults to VITE_API_URL if omitted)
# Leave empty for local Vite proxy support.
VITE_SOCKET_URL=

# Root environment configuration template

# Server port and environment
PORT=3001
NODE_ENV=development

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173

# PostgreSQL & Prisma (for Phase 2+)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cricket_copilot?schema=public

# Redis (for Phase 3+)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Phase 3 replay is disabled unless a local Cricsheet JSON file is specified.
REPLAY_FILE=
REPLAY_INTERVAL_MS=1000

# OpenAI API Key (for Phase 4+)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=15000
OPENAI_MAX_OUTPUT_TOKENS=500


# Root environment configuration template

# Server port and environment
PORT=3001
NODE_ENV=development

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173
CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key
CLERK_AUTHORIZED_PARTIES=http://localhost:5173
# PostgreSQL & Prisma (for Phase 2+)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cricket_copilot?schema=public

# Redis (for Phase 3+)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Local Cricsheet archive. All files load as historical data at backend startup
# except LIVE_REPLAY_FILE, which is replayed when a fan opens that match.
CRICSHEET_DATA_DIR=t20s_male_json
LIVE_REPLAY_FILE=1001349.json
REPLAY_INTERVAL_MS=1000

# Gemini API Key from Google AI Studio (for Phase 4+)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TIMEOUT_MS=30000
GEMINI_MAX_OUTPUT_TOKENS=2000
GEMINI_THINKING_LEVEL=MINIMAL


{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "lint": "eslint .",
    "test": "node --experimental-test-module-mocks --import ./tests/testSetup.js --test tests/**/*.test.js",
    "test:db": "node --experimental-test-module-mocks --env-file=.env --import ./tests/testSetup.js --test tests/**/*.test.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@clerk/backend": "^3.29.0",
    "@clerk/express": "^2.1.90",
    "@google/genai": "^3.6.1",
    "@prisma/client": "^6.5.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "redis": "^4.7.0",
    "socket.io": "^4.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "prisma": "^6.5.0",
    "socket.io-client": "^4.8.1",
    "supertest": "^7.0.0"
  }
}
